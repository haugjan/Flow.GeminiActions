<UserControl
  x:Class="Flow.GeminiActions.Settings.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:settings="clr-namespace:Flow.GeminiActions.Settings"
  d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
  d:DesignHeight="600"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <Grid Margin="{StaticResource SettingPanelMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <TextBlock
      Grid.Row="0"
      Grid.Column="0"
      Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
      VerticalAlignment="Center"
      FontSize="14"
      Text="Gemini API Key"
    />
    <StackPanel
      Grid.Row="0"
      Grid.Column="1"
      Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
      Orientation="Vertical"
    >
      <PasswordBox
        x:Name="ApiKeyBox"
        Width="600"
        PasswordChanged="ApiKeyBox_PasswordChanged"
      />
      <TextBlock Margin="0,4,0,0" FontSize="12">
        <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate">
          Get a Gemini API key &#x2192;
        </Hyperlink>
      </TextBlock>
    </StackPanel>

    <TextBlock
      Grid.Row="1"
      Grid.Column="0"
      Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
      VerticalAlignment="Center"
      FontSize="14"
      Text="Model"
    />
    <TextBox
      Grid.Row="1"
      Grid.Column="1"
      MaxWidth="400"
      Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
      Text="{Binding Settings.Model, UpdateSourceTrigger=PropertyChanged}"
    />

    <TextBlock
      Grid.Row="2"
      Grid.Column="0"
      Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
      VerticalAlignment="Center"
      FontSize="14"
      Text="Timeout (seconds)"
    />
    <TextBox
      Grid.Row="2"
      Grid.Column="1"
      MaxWidth="120"
      Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
      PreviewTextInput="NumberValidationTextBox"
      Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
    />

    <TextBlock
      Grid.Row="3"
      Grid.Column="0"
      Grid.ColumnSpan="2"
      Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
      FontSize="14"
      FontWeight="SemiBold"
      Text="Actions"
    />

    <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel
        Grid.Row="0"
        Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
        Orientation="Horizontal"
      >
        <Button Margin="0,0,8,0" Padding="10,4" Command="{Binding AddActionCommand}" Content="Add" />
        <Button Padding="10,4" Command="{Binding ResetDefaultsCommand}" Content="Reset to defaults" />
      </StackPanel>

      <DataGrid
        Grid.Row="1"
        Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        HeadersVisibility="Column"
        ItemsSource="{Binding Actions}"
      >
        <DataGrid.Columns>
          <DataGridTextColumn Width="160" Binding="{Binding Title}" Header="Title" />
          <DataGridTextColumn Width="220" Binding="{Binding Description}" Header="Description" />
          <DataGridTemplateColumn Width="*" Header="Instruction">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock
                  Margin="4,3"
                  Text="{Binding Instruction}"
                  TextWrapping="Wrap"
                  VerticalAlignment="Top"
                />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
              <DataTemplate>
                <TextBox
                  AcceptsReturn="True"
                  MinHeight="80"
                  MaxHeight="240"
                  Padding="2"
                  Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}"
                  TextWrapping="Wrap"
                  VerticalScrollBarVisibility="Auto"
                />
              </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="80" Header="">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button
                  Padding="6,2"
                  Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"
                  Content="Remove"
                />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>
