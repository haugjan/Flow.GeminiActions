<Window
  x:Class="Flow.GeminiActions.Editor.SpinnerOverlay"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Gemini Actions"
  Width="260"
  Height="56"
  AllowsTransparency="True"
  Background="Transparent"
  Focusable="False"
  ResizeMode="NoResize"
  ShowActivated="False"
  ShowInTaskbar="False"
  Topmost="True"
  WindowStartupLocation="Manual"
  WindowStyle="None"
>
  <Border
    Margin="6"
    Padding="16,0,18,0"
    Background="#222"
    CornerRadius="10"
  >
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path
        Width="18"
        Height="18"
        VerticalAlignment="Center"
        RenderTransformOrigin="0.5,0.5"
        Stroke="#EEE"
        StrokeEndLineCap="Round"
        StrokeStartLineCap="Round"
        StrokeThickness="2.5"
      >
        <Path.Data>
          <PathGeometry>
            <PathFigure StartPoint="9,1">
              <ArcSegment
                IsLargeArc="False"
                Point="17,9"
                Size="8,8"
                SweepDirection="Clockwise"
              />
            </PathFigure>
          </PathGeometry>
        </Path.Data>
        <Path.RenderTransform>
          <RotateTransform x:Name="SpinnerRotation" Angle="0" />
        </Path.RenderTransform>
        <Path.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation
                  From="0"
                  To="360"
                  Storyboard.TargetName="SpinnerRotation"
                  Storyboard.TargetProperty="Angle"
                  Duration="0:0:1"
                />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Path.Triggers>
      </Path>
      <TextBlock
        x:Name="TitleText"
        Margin="14,0,0,0"
        VerticalAlignment="Center"
        FontSize="13"
        Foreground="#EEE"
        TextTrimming="CharacterEllipsis"
      />
    </StackPanel>
  </Border>
</Window>
