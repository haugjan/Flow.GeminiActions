<Window
  x:Class="Flow.GeminiActions.Editor.EditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Gemini Actions"
  Width="900"
  Height="640"
  MinWidth="500"
  MinHeight="400"
  WindowStartupLocation="CenterScreen"
>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Grid.Row="0"
      Margin="0,0,0,4"
      FontWeight="SemiBold"
      Text="Input"
    />
    <TextBox
      x:Name="InputBox"
      Grid.Row="1"
      AcceptsReturn="True"
      AcceptsTab="True"
      FontFamily="Segoe UI"
      FontSize="13"
      KeyDown="InputBox_KeyDown"
      TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto"
    />

    <DockPanel
      Grid.Row="2"
      Margin="0,10,0,10"
      LastChildFill="True"
    >
      <Button
        x:Name="SendButton"
        Padding="16,5"
        Click="Send_Click"
        Content="Send (Ctrl+Enter)"
        DockPanel.Dock="Right"
        IsDefault="True"
      />
      <Button
        Margin="0,0,8,0"
        Padding="14,5"
        Click="Copy_Click"
        Content="Copy result"
        DockPanel.Dock="Right"
      />
      <TextBlock
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        Text="Action:"
      />
      <ComboBox
        x:Name="ActionCombo"
        MaxWidth="320"
        HorizontalAlignment="Left"
        DisplayMemberPath="Title"
        VerticalContentAlignment="Center"
      />
    </DockPanel>

    <TextBlock
      Grid.Row="3"
      Margin="0,0,0,4"
      VerticalAlignment="Top"
      FontWeight="SemiBold"
      Text="Result"
    />
    <TextBox
      x:Name="OutputBox"
      Grid.Row="3"
      Margin="0,22,0,0"
      AcceptsReturn="True"
      Background="#FAFAFA"
      FontFamily="Segoe UI"
      FontSize="13"
      IsReadOnly="True"
      TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto"
    />

    <TextBlock
      x:Name="StatusText"
      Grid.Row="4"
      Margin="0,8,0,0"
      Foreground="#666"
      Text=""
    />
  </Grid>
</Window>
